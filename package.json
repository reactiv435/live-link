{
  "name": "reactivvibe-live-link",
  "productName": "ReactivVibe LIVE Link",
  "version": "2.0.5",
  "description": "Sends your TikTok LIVE taps to the ReactivVibe hype bar, records your LIVEs and turns every review into a clip.",
  "main": "src/main.js",
  "license": "AGPL-3.0-only",
  "author": "ReactivVibeAI",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "mock": "node test/mock-server.js",
    "smoke": "node scripts/smoke.js",
    "dist": "node scripts/fetch-ffmpeg.js win32-x64 && node scripts/make-source.js && electron-builder --win nsis && node scripts/release.js",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js"
  },
  "dependencies": {
    "tiktok-live-connector": "2.4.4"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.reactivvibe.livelink",
    "productName": "ReactivVibe LIVE Link",
    "artifactName": "LIVE-Link-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.*",
      "package.json",
      "LICENSE.txt",
      "build/tray*.png"
    ],
    "extraResources": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "dist-source",
        "to": "source"
      },
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64",
          "to": "ffmpeg/win32-x64"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReactivVibe LIVE Link",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon-1024.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "LIVE-Link-${version}-mac.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin-x64",
          "to": "ffmpeg/darwin-x64"
        },
        {
          "from": "vendor/ffmpeg/darwin-arm64",
          "to": "ffmpeg/darwin-arm64"
        }
      ],
      "x64ArchFiles": "Contents/Resources/ffmpeg/**"
    },
    "dmg": {
      "artifactName": "LIVE-Link-${version}-mac.${ext}",
      "title": "ReactivVibe LIVE Link"
    }
  }
}
